# 텔레그램 봇 설정 (필수)
# @BotFather 에서 봇 생성 후 토큰 입력
TELEGRAM_TOKEN=your_telegram_bot_token_here

# 텔레그램 채팅 ID (필수)
# @userinfobot 에게 메시지 보내면 확인 가능
TELEGRAM_CHAT_ID=your_chat_id_here

# DART 전자공시 API 키 (국내 주식 공시 알림용, 선택)
# https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# 데이터베이스 파일 경로
DB_PATH=alramsys.db

# 이벤트 체크 주기 (초)
KR_CHECK_INTERVAL=3600
US_CHECK_INTERVAL=21600

# 알림 기준 (N일 이내 이벤트 알림)
ALERT_DAYS_AHEAD=7

# Finnhub API 키 (미국 주식 실적 추정치 조회용, 선택)
# https://finnhub.io 에서 무료 발급
FINNHUB_API_KEY=

# Anthropic API 키 (AI 분석 코멘트 생성용, 선택)
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 이상 징후 감지 임계값 (기본값 사용 권장)
# 코스피/코스닥 하락 % (예: -3.0 = -3% 이상 하락 시 알림)
ANOMALY_KOSPI_DROP=-3.0
ANOMALY_KOSDAQ_DROP=-3.0
# VIX 절대값 또는 전일 대비 급등 %
ANOMALY_VIX_LEVEL=30.0
ANOMALY_VIX_SPIKE=20.0
# 원달러 하루 상승 %
ANOMALY_KRW_SPIKE=1.0
# 미국 10년물 하루 급등 (bp)
ANOMALY_TNX_BP=10.0
# 이상 징후 체크 주기 (초, 기본 1시간)
ANOMALY_CHECK_INTERVAL=3600
