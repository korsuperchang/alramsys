{
  "name": "golf-swing-shorts",
  "version": "1.0.0",
  "description": "프로 vs 일반인 골프 스윙 비교 숏츠(1080x1920) 렌더러",
  "main": "index.js",
  "scripts": {
    "tts": "node src/tts.mjs",
    "build": "node src/build.mjs",
    "video": "node src/build.mjs && node src/render.mjs",
    "audio": "node src/audio.mjs",
    "all": "node src/tts.mjs && node src/build.mjs && node src/render.mjs && node src/audio.mjs",
    "preview": "node src/build.mjs && node src/render.mjs --from 0 --to 20 --out out/preview.mp4",
    "stills": "node src/build.mjs && node src/render.mjs --stills 2,6,12,22,30,36,42,48,54,58,62"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.62.1",
    "pretendard": "^1.3.9"
  },
  "private": true,
  "type": "module"
}